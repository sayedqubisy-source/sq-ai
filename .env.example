# SQ AI runtime
NODE_ENV=production
PORT=3000
DB_PATH=/app/data/sq-ai.sqlite
APP_URL=
# false for direct access; 1 for a single trusted reverse proxy
TRUST_PROXY=false
SESSION_DAYS=30
REQUEST_TIMEOUT_MS=180000
AGENT_TIMEOUT_MS=600000
# Maximum downloaded image/audio/video size (250 MiB by default)
MAX_MEDIA_BYTES=262144000

# Primary free-first LLM gateway
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional direct model providers — add only when needed
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VEO_MODEL=veo-3.1-generate-preview
LYRIA_MODEL=lyria-3.5
MEDIA_PROMPT_ENHANCER=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
COHERE_API_KEY=
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
REPLICATE_API_TOKEN=
FAL_KEY=

# Voice / speech
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Search / research / web extraction
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
APIFY_API_TOKEN=

# Free video mode
FREE_VIDEO_SPACE=alexcheng0072/wan27-free-video-generator
FREE_VIDEO_DURATION_SECONDS=3
PAID_VIDEO_ENABLED=false

# Optional Hugging Face video provider
HF_TOKEN=
HF_VIDEO_PROVIDER=fal-ai
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B

# Optional custom paid video API used by the legacy video path
VIDEO_API_URL=
VIDEO_API_KEY=
VIDEO_MODEL=

# Paddle Billing
# Use sandbox while testing, then switch to production with a live API key.
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_SCALE=
PADDLE_CHECKOUT_URL=
