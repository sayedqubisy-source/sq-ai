# SQ AI runtime
NODE_ENV=production
PORT=3000
DB_PATH=/app/data/sq-ai.sqlite
APP_URL=

# Primary free-first LLM gateway
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# Optional direct model providers — add only when needed
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=

# Voice / speech
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Search / research / web extraction
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
APIFY_API_TOKEN=

# Free video mode
FREE_VIDEO_SPACE=alexcheng0072/wan27-free-video-generator
FREE_VIDEO_DURATION_SECONDS=3
PAID_VIDEO_ENABLED=false

# Optional Hugging Face video provider
HF_TOKEN=
HF_VIDEO_PROVIDER=fal-ai
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B

# Paddle Billing
# Use sandbox while testing, then switch to production with a live API key.
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_SCALE=
PADDLE_CHECKOUT_URL=
