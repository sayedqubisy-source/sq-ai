# SQ AI
NODE_ENV=production
PORT=3000
DB_PATH=/app/data/adflow.sqlite

# OpenRouter (text/image)
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=your_image_model

# Free video mode (default)
FREE_VIDEO_SPACE=alexcheng0072/wan27-free-video-generator
FREE_VIDEO_DURATION_SECONDS=3
PAID_VIDEO_ENABLED=false

# Optional paid video mode (only enable when a paid provider/key is configured)
# OPENROUTER_VIDEO_MODEL=your_paid_video_model
# VIDEO_DURATION_SECONDS=4
# VIDEO_RESOLUTION=720p
# VIDEO_GENERATE_AUDIO=false
# VIDEO_MAX_WAIT_MS=360000
# VIDEO_POLL_MS=10000

# Optional Hugging Face Inference Provider route
# HF_TOKEN=hf_your_token
# HF_VIDEO_PROVIDER=fal-ai
# HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B

# Paddle (configure only when your checkout integration is enabled)
# PADDLE_API_KEY=your_paddle_api_key
# PADDLE_CLIENT_TOKEN=your_paddle_client_token
