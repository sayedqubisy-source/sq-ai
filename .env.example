# SQ AI
NODE_ENV=production
PORT=3000
DB_PATH=/app/data/adflow.sqlite

# OpenRouter (text/image)
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=your_text_model
OPENROUTER_IMAGE_MODEL=your_image_model

# Preferred video provider: Hugging Face Inference Providers
# Free accounts currently receive a small monthly inference credit; usage is not unlimited free.
HF_TOKEN=hf_your_token
HF_VIDEO_PROVIDER=fal-ai
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B

# Optional explicit custom video provider fallback when HF_TOKEN is not set.
# VIDEO_API_URL=https://YOUR-VIDEO-PROVIDER.example/generate
# VIDEO_API_KEY=your_video_provider_key
# VIDEO_MODEL=your_explicit_video_model_id

# Paddle (configure only when your checkout integration is enabled)
# PADDLE_API_KEY=your_paddle_api_key
# PADDLE_CLIENT_TOKEN=your_paddle_client_token
